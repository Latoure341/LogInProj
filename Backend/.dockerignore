# Ignore local dependencies and build artifacts
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Ignore environment and secret files
.env
.env.*

# Editor directories and system files
.DS_Store
.git
.gitignore
.vscode
.idea

# Ignore temporary files and logs
*.log
tmp
temp
*.tgz

# Ignore build output
dist
build
coverage
